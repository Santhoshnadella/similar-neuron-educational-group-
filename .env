# =================================================================
# KnowledgeVerse — Environment Configuration (Local MVP Running)
# =================================================================

# ── App ──────────────────────────────────────────────────────────
APP_NAME=KnowledgeVerse
APP_ENV=development
APP_SECRET_KEY=mvp-local-secret-key-change-in-production-12345

# ── Database (SQLite - Local File, Zero Setup) ─────────────────────
DATABASE_URL=sqlite+aiosqlite:///./knowledgeverse.db

# ── Local AI — LM Studio (PRIMARY) ───────────────────────────────
# 1. Get LM Studio → https://lmstudio.ai
# 2. Load model:  google/gemma-2-4b-it  (Gemma 4 E2B)
# 3. Local Server tab → Start Server (default port 1234)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=gemma-2-4b-it
LM_STUDIO_ENABLED=true

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=mvp-local-jwt-secret-key-minimum-32-characters-long-12345
JWT_EXPIRE_MINUTES=10080                    # 7 days

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=mvp-local-nextauth-secret-key-change-12345
