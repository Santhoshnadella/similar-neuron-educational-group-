# =================================================================
# KnowledgeVerse — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =================================================================

# ── App ──────────────────────────────────────────────────────────
APP_NAME=KnowledgeVerse
APP_ENV=development                         # development | production
APP_SECRET_KEY=CHANGE_ME_min32chars_random  # openssl rand -hex 32

# ── Database (SQLite - Local File, Zero Setup) ─────────────────────
DATABASE_URL=sqlite+aiosqlite:///./knowledgeverse.db

# ── Local AI — LM Studio (PRIMARY) ───────────────────────────────
# 1. Get LM Studio → https://lmstudio.ai
# 2. Load model:  google/gemma-2-4b-it  (Gemma 4 E2B)
# 3. Local Server tab → Start Server (default port 1234)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=gemma-2-4b-it
LM_STUDIO_ENABLED=true

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min32chars_random      # openssl rand -hex 32
JWT_EXPIRE_MINUTES=10080                    # 7 days

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_min32chars_random # openssl rand -hex 32
